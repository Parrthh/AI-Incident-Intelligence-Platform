# Copy to .env for local development. Never commit .env.
# Every setting can also be passed as a normal environment variable.

# development | test | production
IIP_ENV=development

# Port for the API. Hosting platforms usually set PORT instead, which also works.
IIP_PORT=8000

# DEBUG | INFO | WARNING | ERROR
IIP_LOG_LEVEL=INFO

# true = one JSON object per line (production). false = readable console output.
IIP_LOG_JSON=false

# Proxies allowed to set X-Forwarded-* headers. Use "*" only behind a load balancer you control.
IIP_FORWARDED_ALLOW_IPS=127.0.0.1

# Postgres. Provider URLs like postgresql://user:pass@host/db?sslmode=require work as-is.
# Matches the `make dev` stack:
IIP_DATABASE_URL=postgresql://iip:iip-dev-only@127.0.0.1:5432/iip

# Redis. Use rediss:// (two s's) for TLS, e.g. Upstash.
IIP_REDIS_URL=redis://127.0.0.1:6379/0
